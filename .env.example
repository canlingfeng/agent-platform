# 用法：cp .env.example .env 后填真实值。
# .env 已在 .gitignore 中，不会进 Git，也不会进镜像（.dockerignore 排除）。
MYSQL_ROOT_PASSWORD=change-me-root-pw
AGENT_DB_USER=agent_app
AGENT_DB_PASSWORD=change-me-app-pw
# 对话模型密钥（core/models.py 的 chat 能力）
MODELSCOPE_API_KEY=ms-your-key-here
# 向量化 / 重排序密钥（embedding、rerank 能力，走硅基流动 BAAI/bge-m3）
# 免费模型仍需实名认证后创建 Key：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=
# JWT 签名密钥（必填，缺失则服务拒绝启动）。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_JWT_SECRET=

# ---- MCP（可选）：前两项是 JSON 字符串，必须写成单行，值内不要出现 #；第三项是浮点数秒数 ----

# AGENT_MCP_SERVERS：stdio server 配置列表；command 必须是容器内可执行文件，
# 不能写宿主 Windows 路径（如 D:/ana/python.exe）。
# 启用示例（对应镜像内 mcp_servers/echo_server.py，相对 WORKDIR /app）：
#   AGENT_MCP_SERVERS=[{"name":"echo","command":"python","args":["mcp_servers/echo_server.py"]}]
# 默认值 [] = 不启用 MCP（fail-open，服务照常启动，只是没有 MCP 工具）。
# 注意：写 [] 而不是留空串——空串会让 json.loads("") 抛 JSONDecodeError。
# 走裸跑 Python（run.py + python-dotenv）时同样能拿到合法 JSON。
AGENT_MCP_SERVERS=[]
# AGENT_MCP_ALLOW：允许调用的 MCP 工具名白名单，如 ["echo__echo"]。
# 默认值 [] = 全部拒绝（fail-closed，失败关闭 / 最小权限）；未列入白名单的工具一律 DENY。
# 注意：工具名格式为 <server 名>__<工具名>，与 L1 注册时生成的 key 一致。
AGENT_MCP_ALLOW=[]
# AGENT_MCP_CONNECT_TIMEOUT：一批 MCP server 并行连接的总等待上限（秒，浮点数）。
# 由 core/mcp_client.py 的 _connect_timeout() 读取；未配置或非数字时回退 5.0，
# 小于 0.1 会被抬到 0.1（防误配成 0 导致所有 server 被判 timeout）。
# 调大：server 数量多、握手慢；调小：让启动阶段快速失败，不让慢 server 拖住服务就绪。
# 三层默认值必须一致：代码 5.0、此处 5.0、docker-compose.yml 的 :-5.0。
AGENT_MCP_CONNECT_TIMEOUT=5.0

# ---- 配额：单次请求 token 上限 ----
# AGENT_MAX_TOKENS_PER_REQUEST：一次请求最多允许消耗的 token（整数）。
# 实际生效值 = min(该值, 今日剩余额度)，由 api/chat.py 的 _resolve_token_cap() 计算：
#   - 只用固定值 → 剩余额度很少的用户单次仍可能超额几百倍；
#   - 只用剩余额度 → 一次超长回答就把整天额度吃光，等于没有单次门槛。
# 流式路径在 producer 里逐 chunk 判停（触及即中止，已消耗照常记账）；
# 同步路径无法中途打断，只做事后稽核并在响应体里回传 capped 标记。
# 三层默认值必须一致：代码 20000、此处 20000、docker-compose.yml 的 :-20000。
AGENT_MAX_TOKENS_PER_REQUEST=20000