# 用法：cp .env.example .env 后填真实值。
# .env 已在 .gitignore 中，不会进 Git，也不会进镜像（.dockerignore 排除）。
MYSQL_ROOT_PASSWORD=change-me-root-pw
AGENT_DB_USER=agent_app
AGENT_DB_PASSWORD=change-me-app-pw
MODELSCOPE_API_KEY=ms-your-key-here
# JWT 签名密钥（必填，缺失则服务拒绝启动）。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_JWT_SECRET=